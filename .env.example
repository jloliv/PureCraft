# PureCraft — environment template.
# Copy to `.env.local` (gitignored) and fill in real values for local dev.
# All EXPO_PUBLIC_* variables are bundled into the JS that ships to users —
# never put a service-role key or any private secret behind this prefix.

# ----- Supabase (required) -----
# From the Supabase dashboard → Project Settings → API.
# URL is your project's REST endpoint; the anon key is safe to expose to
# clients because Row Level Security gates every table.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ----- PostHog analytics (optional) -----
# Leaving these blank disables analytics — the wrapper in lib/analytics.ts
# becomes a no-op and the app still runs.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----- Sentry crash reporting (optional) -----
# Leaving this blank disables Sentry. In production you'll want this set so
# crash signals from real devices reach the dashboard.
EXPO_PUBLIC_SENTRY_DSN=
